{
  "name": "agente-firebird",
  "version": "1.0.0",
  "private": true,
  "description": "Agente da Sinsoft que executa consultas no Firebird local e devolve JSON",
  "main": "dist/server.js",
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec \"ts-node src/server.ts\"",
    "build": "tsc",
    "start": "node dist/server.js",
    "empacotar": "npm run build && pkg dist/server.js --targets node16-win-x64 --output dist/agente-firebird.exe"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "node-firebird": "^1.1.8",
    "iconv-lite": "^0.6.3"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^20.14.9",
    "@yao-pkg/pkg": "^6.14.2",
    "nodemon": "^3.1.4",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.3"
  },
  "bin": "dist/server.js",
  "pkg": {
    "assets": [],
    "outputPath": "dist"
  }
}