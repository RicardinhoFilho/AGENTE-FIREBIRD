# Porta em que o agente escuta, dentro da prefeitura.
PORT=3060

# ─────────────────────────────────────────────────────────────────────────────
# CHAVE — obrigatoria. O agente NAO sobe sem ela.
# Ele executa SQL no banco da prefeitura; sem chave, qualquer um na rede faria o
# mesmo. Gere algo longo e aleatorio (nao digite):
#     node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# A mesma chave vai no .env dos sistemas que chamam o agente.
# ─────────────────────────────────────────────────────────────────────────────
AGENTE_CHAVE=

# Se preenchido, so estes IPs podem chamar (os servidores da Sinsoft).
# Vazio = qualquer origem que tenha a chave. Separados por virgula.
IPS_PERMITIDOS=

# ─────────────────────────────────────────────────────────────────────────────
# Somente leitura (padrao).
# Recusa tudo que nao for SELECT/WITH. Os relatorios so leem, e um agente que so
# le nao consegue destruir um exercicio inteiro se a chave vazar. So ligue se
# algum sistema realmente precisar gravar — e, mesmo assim, prefira restringir
# tambem no Firebird, com um usuario sem permissao de escrita.
# ─────────────────────────────────────────────────────────────────────────────
PERMITIR_ESCRITA=false

# Corta a consulta que passar disto. Protege a memoria e o link da prefeitura,
# que costuma ter upload magro.
MAX_LINHAS=200000

# Tempo maximo de uma consulta (ms).
TIMEOUT_MS=120000

# Conexoes por banco.
TAMANHO_POOL=5

# Senha do SYSDBA por versao do Firebird — mesma regra dos outros sistemas da
# casa. So mexa se elas mudarem.
FB_SENHA_V3=SIN_S1_S2
FB_SENHA_V15=masterkey

# ─────────────────────────────────────────────────────────────────────────────
# Backup (rota /backup): gbak -> zip -> FTP da Sinsoft.
#
# O DESTINO NAO VEM NO PEDIDO, so o banco. Se quem chama pudesse escolher para
# onde mandar, a rota viraria ferramenta de exfiltracao: com a chave em maos,
# qualquer um levaria a base da prefeitura para o proprio servidor.
#
# Tudo abaixo ja tem padrao compilado no exe — so preencha para mudar.
# ─────────────────────────────────────────────────────────────────────────────
PERMITIR_BACKUP=true

# Destino. A subpasta do municipio vem no pedido: agente_firebird/<MUNICIPIO>/
# Prefira uma conta so de escrita, sem permissao de listar nem baixar:
# a senha fica compilada no exe, que roda em toda prefeitura.
FTP_HOST=
FTP_USUARIO=
FTP_SENHA=
FTP_PASTA=agente_firebird
# FTPS explicito. So ligue se o servidor suportar.
FTP_SEGURO=false

# Onde procurar o gbak.exe, separado por virgula. Tem que ser a MESMA versao do
# servidor Firebird — o gbak do 3.0 nao le base 1.5. Vazio = procura sozinho nos
# caminhos padrao de instalacao.
GBAK_V3=
GBAK_V15=

# Pasta dos temporarios (.fbk e .zip). Vazio = TEMP do sistema. O .fbk pode ter
# o tamanho do banco; aponte para um disco com espaco.
BACKUP_PASTA=

# Teto de um backup inteiro (gbak + zip + envio). Base grande demora.
BACKUP_TIMEOUT_MS=7200000
